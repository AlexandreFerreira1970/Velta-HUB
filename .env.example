# Copie para .env.local e preencha.

# ─── Auth (Google) ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
# URL onde o app roda. Local: http://localhost:3000 — NUNCA a URL de produção,
# senão o login com Google volta para o site publicado em vez do localhost.
# Na Vercel pode ficar vazia (é detectada automaticamente).
NEXTAUTH_URL=http://localhost:3000

# ─── Provedores ──────────────────────────────────────────────────────────────
# IA:    azure (Azure AI Foundry, padrão) | openai
AI_PROVIDER=azure
# Banco: cosmos (Azure Cosmos DB, padrão) | neon (Postgres)
DB_PROVIDER=cosmos

# ─── AI_PROVIDER=openai ──────────────────────────────────────────────────────
OPENAI_API_KEY=
# Modelo usado pelo assistente (ex.: o que você escolher no painel da OpenAI)
OPENAI_MODEL=
# Opcional: modelo do agente que extrai indicadores (/api/hub/analyze)
OPENAI_HUB_SCORE_MODEL=

# ─── AI_PROVIDER=azure ───────────────────────────────────────────────────────
AZURE_AI_PROJECT_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_AGENT_NAME=
AZURE_FOUNDRY_AGENT_VERSION=1

# ─── DB_PROVIDER=neon ────────────────────────────────────────────────────────
# Connection string do painel do Neon. As tabelas são criadas automaticamente.
DATABASE_URL=

# ─── DB_PROVIDER=cosmos ──────────────────────────────────────────────────────
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=velta
